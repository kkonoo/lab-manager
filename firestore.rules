rules_version = '2';
// 랩 행정 — Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여 넣어요.
// users/{uid}/**  : PI 본인만 (과제·인건비·세목·정보·서류·내 정보)
// labs/{PI uid}   : 랩 문서 { owner, ownerEmail, ownerName, members: [학생 구글 이메일(소문자)] } — PI만 고침
// labs/{PI uid}/**: 재고(묶음·위치·업체·프로토콜·품목·주문) — PI와 멤버가 읽고 씀
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    function verified() { return request.auth.token.email_verified == true; }

    match /users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /labs/{labId} {
      function isOwner() { return signedIn() && request.auth.uid == labId; }
      function isMember() {
        return signedIn() && verified() && myEmail() in get(/databases/$(database)/documents/labs/$(labId)).data.members;
      }
      // 랩 문서: PI는 읽고 씀, 멤버는 읽기만 (학생이 '내 랩' 찾기: members array-contains 내 이메일)
      allow read: if isOwner() || (signedIn() && verified() && myEmail() in resource.data.members);
      allow create, update: if isOwner() && request.resource.data.owner == request.auth.uid;
      allow delete: if isOwner();

      match /{rest=**} {
        allow read, write: if isOwner() || isMember();
      }
    }
  }
}
